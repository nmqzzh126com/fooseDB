# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment variables (contains secrets)
# —— 只忽略真正含密钥的运行时文件 ——
# admin-vue/.env* 是 Vite 构建模板（端口、proxy、SDK baseURL），不含密钥，应当提交 ——
.env
!.env.example
!admin-vue/.env
.env.local
.env.*.local
api-fastify/.env
api-fastify/.env.*
!api-fastify/.env.example

# Database files
*.db
*.db-wal
*.db-shm
*.db-journal

# API uploads (file storage)
api-fastify/uploads/

# pnpm store (project-local)
.pnpm-store/

# Logs
*.log
logs/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# ===== 本地工具二进制（Windows 便携 Redis 等） =====
# 源码/压缩包本身保留，运行产物与编译产物忽略
*.exe
*.pdb
*.dll
*.pid
*.zip
*.gz
*.tar
*.7z

# Windows Redis 运行数据
tools/redis/dump.rdb
tools/redis/*.log
