# HTTP 监听地址与端口
# HOST 默认 0.0.0.0（监听所有网卡）；仅允许本机访问可设 127.0.0.1
HOST=0.0.0.0
PORT=8858

# 管理后台入口路径（用户可自定义，实现自定义访问地址）
# - 必须以 / 开头，不能以 / 结尾；段内仅允许「字母/数字/下划线/中划线」，可多级
# - 合法示例：/admin（默认）  /portal  /manage  /sys/v1/console
# - 非法示例如:/, /../evil, //admin, /admin/ （会自动回退到 /admin，并在启动日志中 WARN）：
# 开发模式下 admin-vue/vite.config.ts 会自动读取本 .env 的 ADMIN_PATH**，
ADMIN_PATH=/admin

# ===== 管理端面板账号 =====
# admin 账号登录优先级高于 users 表（同样 username 在 users 表有也永远走 .env 分支，
# 签发带 admin-panel scope 的 JWT；users 表仅保留一条 shadow 行作为 refresh_tokens 外键锚点）。
# 密码支持两种格式：明文（开发方便）或以 $2 开头的 bcrypt 哈希（生产推荐）。
# nickname 用于前端显示，默认 "系统管理员"；不配置或配空时回退默认。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_NICKNAME=系统管理员

# JWT 签名密钥（生产环境务必更换为 32+ 位随机字符串）
JWT_SECRET=dev-secret-please-change-in-production-2026



# Token 有效期（秒）。不配置时使用默认：access=2 小时（7200），refresh=7 天（604800）
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=7200

# ===== 认证 / 登录性能调优（均可省略，用默认值） =====
# 登录校验短缓存：同一「用户名+密码」在窗口内重复登录跳过 bcrypt（多客户端共用同一账号时显著降 CPU）。
#   改密/重置密码后该缓存立即失效（比对 DB 哈希）；密码错误不缓存。默认 30 秒，设 0 关闭。
# LOGIN_CHECK_CACHE_TTL_SEC=30
# token_version 缓存：改密/踢人后旧 token 最长宽限时间（秒）。默认 10。
# TOKEN_VERSION_CACHE_TTL_SEC=10

# 登录接口限流（IP 维度）：窗口内最多尝试次数 / 窗口时长（秒）。
#   超限返回 429 并带 Retry-After；Redis 未启用（Stub）时自动放行。
#   不配置或配置非法（0/负数/小数/非数字）时回退默认：5 次 / 60 秒。
LOGIN_RATE_LIMIT=30
LOGIN_WINDOW_SEC=60

# ===== 其他运行参数（均可省略，用默认值；非法值自动回退默认） =====
# bcrypt 哈希强度：仅接受 4~31 的整数，默认 10。越大越安全但登录/改密越慢（每 +1 耗时约翻倍）。
# BCRYPT_COST=10
# 通用分页接口（/api/:object/:table）：默认每页条数 / 单次请求最大每页条数（超出自动截断，防一次拖出大表）。
PAGE_SIZE_DEFAULT=10
# 最大每页条数，默认 500 条
PAGE_SIZE_MAX=500
# 已过期 refresh_tokens 定时清理间隔（小时）：默认 24；设 0 关闭定时清理（服务启动时仍会清理一次）。
# REFRESH_TOKEN_PURGE_INTERVAL_HOURS=24

# ===== 建议安装并开启redis：默认通用缓存（KV 查询缓存 / 分布式锁通用） =====
REDIS_CACHE_DEFAULT__ENABLED=true
REDIS_CACHE_DEFAULT__URL=redis://127.0.0.1:6379

